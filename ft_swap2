#include <stdio.h>

int	main(int argc, int **argv)
{
	// Insertion sort
	int	i;
	int	j;
	int	key;

	i = 1;
	while (i < argc)
	{
		key = argv[i];
		j = i - 1;
		while (j >= 0 && argv[j] > key)
		{
			argv[j + 1] = argv[j];
			j--;
		}
